# ─────────────────────────────────────────────────────────────────────────────
# functions/.env.example
# Copy this file to functions/.env and fill in every value marked REQUIRED.
# functions/.env is gitignored — never commit it.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM provider ─────────────────────────────────────────────────────────────
# Which LLM backend to use. Default: anthropic.
# Set to "gemini" if you prefer Google Gemini with Google Search grounding.
LLM_PROVIDER=anthropic

# Anthropic API key — get one at https://console.anthropic.com/
# REQUIRED when LLM_PROVIDER=anthropic (the default).
ANTHROPIC_API_KEY=sk-ant-...

# Claude model to use. Default: claude-sonnet-4-6 (recommended for research tasks).
# Swap for claude-haiku-4-5-20251001 if you want faster / cheaper responses.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Gemini API key — only needed if LLM_PROVIDER=gemini.
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-flash

# ── Firebase / owner ──────────────────────────────────────────────────────────
# Your Firebase Auth UID. Find it on the Profile page after you sign in, or in
# the Firebase console under Authentication → Users.
# REQUIRED: the nightly cron and security rules both use this.
# After setting it here, also paste it into firestore.rules (see setup below).
OWNER_UID=

# ── Nightly cron schedule ─────────────────────────────────────────────────────
# When to run the nightly opportunity scan. Cron syntax, evaluated in NIGHTLY_TZ.
# Default: 2:00 AM local time.
NIGHTLY_CRON=0 2 * * *
NIGHTLY_TZ=America/Denver

# ── Applicant profile ─────────────────────────────────────────────────────────
# Used by the application_prep skill to draft affiliate applications honestly.
# Fill these in — the LLM will not embellish them.
APPLICANT_NAME=
APPLICANT_WEBSITE=
APPLICANT_TRAFFIC_SUMMARY=Small owner-operated marketing agency serving professional-services firms.

# ── Research tuning ───────────────────────────────────────────────────────────
# Set to "false" to skip the Chromium fallback in the page reader (faster, less thorough).
# Default: true (browser fallback enabled).
# RESEARCH_BROWSER_FALLBACK=true
