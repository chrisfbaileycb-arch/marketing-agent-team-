# Copy to functions/.env  (git-ignored). Never commit real values.

# Which model provider runs the skills: "gemini" (default, AI Studio key) or "anthropic"
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Your Firebase Auth UID. Only tasks/proposals owned by this UID are processed.
OWNER_UID=

# Public-facing facts the agent may use when drafting affiliate applications.
# Keep this honest — networks verify it.
APPLICANT_NAME=
APPLICANT_WEBSITE=
APPLICANT_TRAFFIC_SUMMARY="Small owner-operated marketing platform; email list + social; US audience"

# Nightly run: cron (5 fields) and IANA timezone
NIGHTLY_CRON="0 2 * * *"
NIGHTLY_TZ=America/Denver

# Page reader. Plain HTTP first; headless Chromium (@sparticuz/chromium) only when a page is JS-rendered.
# Set false to never launch a browser (cheaper, less accurate on JS-heavy sites).
RESEARCH_BROWSER_FALLBACK=true
# Local dev only: path to a Chrome/Chromium binary so the CLI doesn't have to download one.
# CHROME_PATH=/usr/bin/chromium
